DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"   # from Neon, see #4
AUTH_SECRET="replace-with-a-long-random-string"    # any long random string — run: openssl rand -base64 32
VAPID_PUBLIC_KEY=""    # generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=""   # (from the same command output above)
TELEGRAM_BOT_TOKEN=""  # from @BotFather on Telegram after you create a bot
CRON_SECRET=""         # any random string — run: openssl rand -base64 32