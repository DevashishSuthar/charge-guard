# Postgres connection string (Neon pooled connection recommended).
# Used for both the app runtime and `prisma migrate`/`db push` — this schema
# doesn't split pooled/direct URLs, so one value covers both.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Message @BotFather on Telegram, /newbot, copy the token it gives you.
TELEGRAM_BOT_TOKEN=""

# Any random string — sent as a Bearer token by Vercel Cron to authorize
# calls to /api/cron/check-reminders. Generate with: openssl rand -hex 32
CRON_SECRET="change-me"